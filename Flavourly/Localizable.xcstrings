    "Send the meals you log to Health, so your nutrition sits next to your activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل الوجبات التي تسجّلها إلى صحتي لتكون تغذيتك بجانب نشاطك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende deine eingetragenen Mahlzeiten an Health, damit deine Ernährung neben deiner Aktivität steht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλε στην Υγεία τα γεύματα που καταγράφεις, ώστε η διατροφή σου να βρίσκεται δίπλα στη δραστηριότητά σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a Salud las comidas que registras, para tener tu nutrición junto a tu actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez vos repas notés à Santé, pour voir votre nutrition à côté de votre activité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने लॉग किए भोजन Health में भेजें, ताकि आपका पोषण आपकी गतिविधि के साथ रहे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia a Salute i pasti che registri, così la nutrizione è accanto all’attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した食事をヘルスケアに送り、栄養と活動を一緒に確認できます。"
