    "Paste or type a recipe — the name, ingredients and steps. Notes, captions and emails work too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق أو اكتب وصفة — الاسم والمكونات والخطوات. الملاحظات والتعليقات والرسائل تنفع أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Rezept ein oder tippe es – Name, Zutaten und Schritte. Notizen, Bildunterschriften und E-Mails gehen auch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικόλλησε ή γράψε μια συνταγή — όνομα, υλικά και βήματα. Ισχύουν και σημειώσεις, λεζάντες και email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega o escribe una receta — el nombre, los ingredientes y los pasos. También sirven notas, pies de foto y correos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez ou tapez une recette — le nom, les ingrédients et les étapes. Notes, légendes et e-mails fonctionnent aussi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेसिपी पेस्ट करें या लिखें — नाम, सामग्री और स्टेप्स। नोट, कैप्शन और ईमेल भी चलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla o scrivi una ricetta — nome, ingredienti e passaggi. Vanno bene anche note, didascalie ed e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシピを貼り付けるか入力してください — 名前、材料、手順。メモ、キャプション、メールでもOKです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레시피를 붙여넣거나 입력하세요 — 이름, 재료, 단계. 메모, 캡션, 이메일도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole ou digite uma receita — o nome, os ingredientes e os passos. Notas, legendas e e-mails também funcionam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте или напишите рецепт — название, ингредиенты и шаги. Подойдут и заметки, подписи, письма."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir tarif yapıştır ya da yaz — adı, malzemeleri ve adımları. Notlar, açıklamalar ve e-postalar da olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán hoặc nhập công thức — tên, nguyên liệu và các bước. Ghi chú, chú thích và email cũng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴或输入食谱 — 名称、食材和步骤。备注、配文和邮件也可以。"
          }
        }
      }
    },
