          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos règles excluent toutes les idées pour ce repas. Importez une recette ou assouplissez un filtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नियम इस भोजन के हर आइडिया को बाहर कर देते हैं। कोई रेसिपी इम्पोर्ट करें या कोई फ़िल्टर ढीला करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue regole escludono ogni idea per questo pasto. Importa una ricetta o allenta un filtro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
