    "Resets %@. Scanning, pasting and videos stay free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعاد التعيين في %@. المسح واللصق والفيديوهات تبقى مجانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird zurückgesetzt am %@. Scannen, Einfügen und Videos bleiben kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μηδενίζεται %@. Η σάρωση, η επικόλληση και τα βίντεο μένουν δωρεάν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reinicia el %@. Escanear, pegar y los vídeos siguen siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se réinitialise %@. La numérisation, le collage et les vidéos restent gratuits."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को रीसेट होता है। स्कैन, पेस्ट और वीडियो मुफ़्त रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si azzera %@. Scansioni, testo incollato e video restano gratuiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にリセットされます。スキャン、貼り付け、動画は無料のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 초기화돼요. 스캔, 붙여넣기, 영상은 계속 무료예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova em %@. Escanear, colar e vídeos continuam grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновится %@. Сканирование, вставка и видео остаются бесплатными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarihinde sıfırlanır. Tarama, yapıştırma ve videolar ücretsiz kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt lại vào %@. Quét, dán và video vẫn miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将于%@重置。扫描、粘贴和视频仍然免费。"
          }
        }
      }
    },
