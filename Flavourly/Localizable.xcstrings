    "Photo, text and video imports are always free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استيراد الصور والنصوص والفيديوهات مجاني دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto-, Text- und Videoimporte sind immer kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εισαγωγές φωτογραφιών, κειμένου και βίντεο είναι πάντα δωρεάν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las importaciones de fotos, texto y vídeo son siempre gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les importations de photos, de texte et de vidéos sont toujours gratuites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो, टेक्स्ट और वीडियो इम्पोर्ट हमेशा मुफ़्त हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le importazioni di foto, testo e video sono sempre gratuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、テキスト、動画の取り込みはいつでも無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진, 텍스트, 영상 가져오기는 항상 무료예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar fotos, texto e vídeos é sempre grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импорт фото, текста и видео всегда бесплатный."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf, metin ve video aktarımları her zaman ücretsizdir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập ảnh, văn bản và video luôn miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片、文字和视频导入始终免费。"
          }
        }
      }
    },
    "Photos stay on your iPhone — only the text we read is used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الصور على الـ iPhone — نستخدم فقط النص الذي نقرؤه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos bleiben auf deinem iPhone – nur der gelesene Text wird verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες μένουν στο iPhone σου — χρησιμοποιείται μόνο το κείμενο που διαβάζουμε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se quedan en tu iPhone — solo se usa el texto que leemos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos restent sur votre iPhone — seul le texte lu est utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो आपके iPhone पर रहती हैं — सिर्फ़ पढ़ा गया टेक्स्ट इस्तेमाल होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto restano sul tuo iPhone — usiamo solo il testo che leggiamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真はiPhoneに残ります — 読み取ったテキストだけを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진은 iPhone에 남아요 — 읽어 낸 텍스트만 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam no seu iPhone — só usamos o texto que lemos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото остаются на вашем iPhone — используется только распознанный текст."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar iPhone’unda kalır — yalnızca okuduğumuz metin kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh nằm trên iPhone của bạn — chỉ dùng văn bản chúng tôi đọc được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片保留在你的iPhone上 — 只使用我们识别出的文字。"
          }
        }
      }
    },
    "Pick a few favourites. You can explore others later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر بعض المفضلات. يمكنك استكشاف غيرها لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein paar Favoriten. Andere kannst du später entdecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε μερικές αγαπημένες. Τις υπόλοιπες μπορείς να τις εξερευνήσεις αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige algunas favoritas. Puedes explorar otras más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quelques favorites. Vous pourrez en explorer d’autres plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ पसंदीदा चुनें। बाकी आप बाद में देख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli qualche preferita. Potrai esplorarne altre più avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りをいくつか選んでください。ほかはあとで探せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아하는 것을 몇 개 고르세요. 다른 것은 나중에 둘러볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha algumas favoritas. Dá para explorar outras depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите несколько любимых. Остальные можно посмотреть позже."
