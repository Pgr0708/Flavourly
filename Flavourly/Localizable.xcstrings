    "%@ — hidden from ideas, flagged on your recipes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — مخفية من الاقتراحات ومُعلَّمة في وصفاتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – aus Ideen ausgeblendet, in deinen Rezepten markiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — κρύβονται από τις ιδέες και επισημαίνονται στις συνταγές σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — se ocultan de las ideas y se marcan en tus recetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — masqués des idées, signalés dans vos recettes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — सुझावों से छिपाया जाता है, आपकी रेसिपी में चिह्नित किया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — nascosti dalle idee, segnalati nelle tue ricette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — アイデアから除外し、レシピでは注意表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 아이디어에서 숨기고 레시피에 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — ocultados das ideias e sinalizados nas suas receitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — скрываются из идей и отмечаются в ваших рецептах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — fikirlerden gizlenir, tariflerinde işaretlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — ẩn khỏi gợi ý, được đánh dấu trong công thức của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 已从推荐中隐藏，并在你的食谱中标注。"
          }
        }
      }
    },
