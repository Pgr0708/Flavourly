    "This week's free AI plan is used — we'll plan with your rules and history instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استُخدمت خطة الذكاء الاصطناعي المجانية لهذا الأسبوع — سنخطط بقواعدك وسجلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose KI-Plan dieser Woche ist verbraucht – wir planen stattdessen mit deinen Regeln und deinem Verlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δωρεάν πρόγραμμα ΤΝ αυτής της εβδομάδας χρησιμοποιήθηκε — θα προγραμματίσουμε με τους κανόνες και το ιστορικό σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya usaste el plan con IA gratis de esta semana — planificaremos con tus reglas y tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le planning IA gratuit de la semaine est utilisé — nous planifierons avec vos règles et votre historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस हफ़्ते की मुफ़्त AI योजना इस्तेमाल हो गई — हम आपके नियमों और इतिहास से योजना बनाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano IA gratuito di questa settimana è stato usato — pianificheremo con le tue regole e la tua cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の無料AIプランは使用済みです — ルールと履歴をもとに計画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 무료 AI 계획을 사용했어요 — 규칙과 기록으로 계획할게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano com IA grátis desta semana já foi usado — vamos planejar com suas regras e seu histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатный план ИИ на эту неделю использован — спланируем по вашим правилам и истории."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haftanın ücretsiz yapay zekâ planı kullanıldı — kuralların ve geçmişinle planlayacağız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã dùng kế hoạch AI miễn phí của tuần này — chúng tôi sẽ lên kế hoạch theo quy tắc và lịch sử của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周的免费AI计划已用完 — 我们会根据你的规则和历史来规划。"
          }
        }
      }
    },
    "Times like “simmer for 10 minutes” become one-tap timers in Cook Mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقات مثل «اطهُ على نار هادئة 10 دقائق» تصبح مؤقتات بلمسة واحدة في وضع الطبخ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiten wie „10 Minuten köcheln“ werden im Kochmodus zu Timern mit einem Tipp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρόνοι όπως «σιγοβράζεις 10 λεπτά» γίνονται χρονόμετρα με ένα πάτημα στη λειτουργία μαγειρέματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempos como “cocer 10 minutos” se convierten en temporizadores de un toque en el modo cocina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les durées comme « laisser mijoter 10 minutes » deviennent des minuteurs en un geste dans le mode cuisine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“10 मिनट उबालें” जैसे समय कुक मोड में एक-टैप टाइमर बन जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempi come “cuoci per 10 minuti” diventano timer con un tocco nella modalità cucina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「10分煮る」のような時間は、クックモードでワンタップのタイマーになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“10분간 끓이기” 같은 시간은 요리 모드에서 한 번에 시작하는 타이머가 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempos como “cozinhe por 10 minutos” viram timers de um toque no modo cozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время вроде «тушить 10 минут» становится таймером в одно касание в режиме готовки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“10 dakika pişir” gibi süreler Pişirme modunda tek dokunuşluk zamanlayıcılara dönüşür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian như “ninh 10 phút” sẽ thành hẹn giờ một chạm trong Chế độ nấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像“煮10分钟”这样的时间，会在烹饪模式中变成一点即用的计时器。"
          }
        }
      }
    },
