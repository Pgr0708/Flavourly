    "Your prices stay on your devices. Recipes show a cost per serving once most of their ingredients have a price." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى أسعارك على أجهزتك. تعرض الوصفات تكلفة الحصة عندما يكون لمعظم مكوناتها سعر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Preise bleiben auf deinen Geräten. Rezepte zeigen Kosten pro Portion, sobald die meisten Zutaten einen Preis haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές σου μένουν στις συσκευές σου. Οι συνταγές δείχνουν κόστος ανά μερίδα όταν τα περισσότερα υλικά τους έχουν τιμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus precios se quedan en tus dispositivos. Las recetas muestran un coste por ración cuando la mayoría de sus ingredientes tienen precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos prix restent sur vos appareils. Les recettes affichent un coût par portion dès que la plupart de leurs ingrédients ont un prix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी कीमतें आपके डिवाइस पर रहती हैं। जब किसी रेसिपी की ज़्यादातर सामग्री की कीमत पता हो, तब वह प्रति सर्विंग लागत दिखाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi prezzi restano sui tuoi dispositivi. Le ricette mostrano un costo per porzione quando la maggior parte degli ingredienti ha un prezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格はお使いのデバイスに保存されます。材料の大半に価格があると、レシピに1人分の費用が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격은 내 기기에만 저장돼요. 재료 대부분의 가격을 알면 레시피에 1인분 비용이 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus preços ficam nos seus aparelhos. As receitas mostram um custo por porção quando a maioria dos ingredientes tem preço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши цены остаются на ваших устройствах. Рецепты показывают стоимость порции, когда у большинства ингредиентов есть цена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatların cihazlarında kalır. Malzemelerin çoğunun fiyatı olduğunda tarifler porsiyon başına maliyet gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá của bạn chỉ ở trên thiết bị của bạn. Công thức hiện chi phí mỗi phần khi hầu hết nguyên liệu đã có giá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的价格只保存在你的设备上。当食谱的大部分食材都有价格时，会显示每份费用。"
          }
        }
      }
    },
