    "Reminders are scheduled on your iPhone from your plan and pantry — nothing is sent to a server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجدول التذكيرات على الـ iPhone من خطتك ومخزنك — لا يُرسل شيء إلى أي خادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen werden auf deinem iPhone aus Plan und Vorrat geplant – nichts wird an einen Server gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι υπενθυμίσεις προγραμματίζονται στο iPhone σου από το πρόγραμμα και το ντουλάπι — τίποτα δεν στέλνεται σε διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios se programan en tu iPhone a partir de tu plan y tu despensa — no se envía nada a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels sont programmés sur votre iPhone à partir de votre planning et de votre garde-manger — rien n’est envoyé à un serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमाइंडर आपकी योजना और पैंट्री से आपके iPhone पर तय होते हैं — कुछ भी सर्वर पर नहीं भेजा जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria sono programmati sul tuo iPhone da piano e dispensa — nulla viene inviato a un server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーは献立とパントリーからiPhone上で設定されます — サーバーには何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림은 계획과 보관함을 바탕으로 iPhone에서 예약돼요 — 서버로 보내지는 것은 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes são agendados no seu iPhone a partir do seu plano e despensa — nada é enviado a um servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания создаются на вашем iPhone по плану и запасам — на сервер ничего не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatıcılar planın ve kilerinden iPhone’unda planlanır — hiçbir şey sunucuya gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời nhắc được lên lịch trên iPhone từ kế hoạch và tủ đồ — không gửi gì lên máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒根据你的计划和储藏在iPhone上安排 — 不会发送任何内容到服务器。"
          }
        }
      }
    },
