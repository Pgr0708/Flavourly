    "Long-press an item to add what you paid — recipes then show their real cost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على عنصر لتضيف ما دفعته — ستعرض الوصفات تكلفتها الحقيقية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Artikel gedrückt, um den bezahlten Preis einzutragen – dann zeigen Rezepte ihre echten Kosten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα πατημένο ένα είδος για να προσθέσεις τι πλήρωσες — έτσι οι συνταγές δείχνουν το πραγματικό τους κόστος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un artículo para añadir lo que pagaste — así las recetas muestran su coste real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez un article pour ajouter ce que vous avez payé — les recettes affichent alors leur vrai coût."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी आइटम को दबाए रखें और चुकाई कीमत जोड़ें — फिर रेसिपी अपनी असली लागत दिखाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un articolo per aggiungere quanto hai pagato — così le ricette mostrano il costo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムを長押しして支払った金額を追加すると、レシピに実際の費用が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 길게 눌러 지불한 가격을 추가하면 레시피에 실제 비용이 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure um item para adicionar quanto pagou — assim as receitas mostram o custo real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте продукт, чтобы указать, сколько вы заплатили, — тогда рецепты покажут реальную стоимость."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödediğin fiyatı eklemek için bir ürüne basılı tut — tarifler gerçek maliyetini gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một món để thêm giá đã trả — khi đó công thức sẽ hiện chi phí thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按某项可填写实付价格 — 食谱就会显示真实花费。"
