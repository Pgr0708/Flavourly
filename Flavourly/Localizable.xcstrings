    "Meals %@ eat never include these. Imports and swaps are checked too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجبات %@ لا تحتوي على هذه أبدًا. تُفحص عمليات الاستيراد والبدائل أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlzeiten, die %@ isst, enthalten das nie. Importe und Tauschvorschläge werden auch geprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα γεύματα που τρώει %@ δεν τα περιέχουν ποτέ. Ελέγχονται και οι εισαγωγές και οι αντικαταστάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comidas de %@ nunca incluyen estos. También se revisan las importaciones y los cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les repas de %@ n’en contiennent jamais. Les importations et substitutions sont aussi vérifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के भोजन में ये कभी नहीं होंगे। इम्पोर्ट और स्वैप भी जाँचे जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pasti che %@ mangia non li contengono mai. Anche importazioni e sostituzioni vengono controllate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の食事にはこれらを入れません。取り込みや置き換えも確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 식사에는 절대 포함되지 않아요. 가져오기와 대체도 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As refeições que %@ come nunca incluem estes. Importações e trocas também são conferidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В блюдах, которые ест %@, этого никогда не будет. Импорт и замены тоже проверяются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yediği öğünlerde bunlar asla olmaz. Aktarımlar ve değişimler de kontrol edilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bữa ăn của %@ không bao giờ có những thứ này. Món nhập và thay thế cũng được kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@吃的餐绝不会包含这些。导入和替换也会检查。"
          }
        }
      }
    },
