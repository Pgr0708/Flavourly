    "Your pantry is empty — type a few things you have, or skip this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخزنك فارغ — اكتب بعض الأشياء التي لديك، أو تخطَّ هذه الخطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Vorrat ist leer – tippe ein paar Dinge ein, die du hast, oder überspring das."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ντουλάπι σου είναι άδειο — γράψε μερικά πράγματα που έχεις ή παράλειψε αυτό το βήμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu despensa está vacía — escribe algunas cosas que tengas u omite esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre garde-manger est vide — tapez quelques ingrédients que vous avez, ou passez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पैंट्री ख़ाली है — कुछ चीज़ें लिखें जो आपके पास हैं, या इसे छोड़ दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua dispensa è vuota — scrivi qualcosa che hai, oppure salta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パントリーは空です — 手元の物をいくつか入力するか、スキップしてください。"
