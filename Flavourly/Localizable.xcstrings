    "Every chosen meal this week is already planned. Pick more meals or next week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل وجبة اخترتها هذا الأسبوع مخطط لها بالفعل. اختر وجبات أكثر أو الأسبوع القادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede gewählte Mahlzeit dieser Woche ist schon geplant. Wähle weitere Mahlzeiten oder die nächste Woche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα επιλεγμένα γεύματα της εβδομάδας είναι ήδη προγραμματισμένα. Διάλεξε κι άλλα γεύματα ή την επόμενη εβδομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las comidas elegidas de esta semana ya están planificadas. Elige más comidas o la próxima semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les repas choisis cette semaine sont déjà planifiés. Choisissez d’autres repas ou la semaine prochaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस हफ़्ते का हर चुना भोजन पहले से योजना में है। और भोजन या अगला हफ़्ता चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pasto scelto per questa settimana è già pianificato. Scegli altri pasti o la prossima settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週選んだ食事はすべて計画済みです。食事を追加するか、来週を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주에 고른 식사는 모두 계획됐어요. 식사를 더 고르거나 다음 주를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as refeições escolhidas desta semana já estão planejadas. Escolha mais refeições ou a próxima semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все выбранные приёмы пищи на эту неделю уже запланированы. Выберите ещё блюда или следующую неделю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hafta seçilen tüm öğünler zaten planlandı. Daha fazla öğün veya gelecek haftayı seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi bữa đã chọn trong tuần này đều đã có kế hoạch. Hãy chọn thêm bữa hoặc tuần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周选择的每一餐都已安排。请选择更多餐次或下一周。"
          }
        }
      }
    },
    "Every option is checked against your household's rules" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل خيار يُفحص حسب قواعد أسرتك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Option wird mit den Regeln deines Haushalts geprüft"
