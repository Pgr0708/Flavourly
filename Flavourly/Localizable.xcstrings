    "The method may be spoken in the video or hidden in comments. Your ingredients are kept — choose how to add the steps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تكون طريقة التحضير منطوقة في الفيديو أو مخفية في التعليقات. احتفظنا بمكوناتك — اختر كيف تضيف الخطوات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
