        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il procedimento potrebbe essere detto nel video o nascosto nei commenti. I tuoi ingredienti sono conservati — scegli come aggiungere i passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
