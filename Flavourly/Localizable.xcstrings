    "Subscriptions renew automatically unless canceled. Manage or cancel anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجدد الاشتراكات تلقائيًا ما لم تُلغَ. أدِرها أو ألغِها في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch, sofern sie nicht gekündigt werden. Verwalte oder kündige sie jederzeit in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνδρομές ανανεώνονται αυτόματα, εκτός αν ακυρωθούν. Διαχειρίσου ή ακύρωσέ τες όποτε θες στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente salvo que se cancelen. Gestiónalas o cancélalas cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf annulation. Gérez-les ou annulez-les à tout moment dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्सक्रिप्शन अपने-आप रिन्यू होते हैं जब तक रद्द न किए जाएँ। सेटिंग्स में कभी भी प्रबंधित या रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente se non disdetti. Gestiscili o annullali quando vuoi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは解約しない限り自動更新されます。設定からいつでも管理・解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 취소하지 않으면 자동으로 갱신돼요. 설정에서 언제든 관리하거나 취소할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas renovam automaticamente, a menos que sejam canceladas. Gerencie ou cancele quando quiser em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки продлеваются автоматически, если их не отменить. Управлять или отменить можно в любой момент в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler iptal edilmedikçe otomatik yenilenir. İstediğin zaman Ayarlar’dan yönet veya iptal et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói đăng ký tự động gia hạn trừ khi bị hủy. Quản lý hoặc hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非取消，订阅会自动续期。随时可在设置中管理或取消。"
          }
        }
      }
    },
