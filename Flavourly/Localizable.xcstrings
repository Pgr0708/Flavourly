    "Your rules filter out every idea for this meal. Import a recipe or relax a filter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قواعدك تستبعد كل فكرة لهذه الوجبة. استورد وصفة أو خفّف أحد عوامل التصفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Regeln schließen jede Idee für diese Mahlzeit aus. Importiere ein Rezept oder lockere einen Filter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κανόνες σου αποκλείουν κάθε ιδέα για αυτό το γεύμα. Κάνε εισαγωγή μιας συνταγής ή χαλάρωσε ένα φίλτρο."
