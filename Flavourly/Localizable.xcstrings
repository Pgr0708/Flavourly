    "Import from Instagram, TikTok, YouTube or any website — or save ideas from Discover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد من Instagram أو TikTok أو YouTube أو أي موقع — أو احفظ أفكارًا من «اكتشف»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere aus Instagram, TikTok, YouTube oder jeder Website – oder speichere Ideen aus „Entdecken“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνε εισαγωγή από Instagram, TikTok, YouTube ή οποιονδήποτε ιστότοπο — ή αποθήκευσε ιδέες από την Ανακάλυψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa desde Instagram, TikTok, YouTube o cualquier web — o guarda ideas de Descubrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez depuis Instagram, TikTok, YouTube ou n’importe quel site — ou enregistrez des idées depuis Découvrir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram, TikTok, YouTube या किसी भी वेबसाइट से इम्पोर्ट करें — या ‘खोजें’ से आइडिया सहेजें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa da Instagram, TikTok, YouTube o qualsiasi sito — oppure salva idee da Scopri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram、TikTok、YouTube、各種サイトから取り込むか、「見つける」からアイデアを保存しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram, TikTok, YouTube 또는 웹사이트에서 가져오거나, 발견에서 아이디어를 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe do Instagram, TikTok, YouTube ou qualquer site — ou salve ideias do Descobrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте из Instagram, TikTok, YouTube или любого сайта — или сохраняйте идеи из «Обзора»."
