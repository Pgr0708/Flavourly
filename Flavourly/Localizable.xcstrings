    "Delete this collection? Recipes stay in your cookbook." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف هذه المجموعة؟ تبقى الوصفات في كتاب وصفاتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sammlung löschen? Die Rezepte bleiben in deinem Kochbuch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγραφή αυτής της συλλογής; Οι συνταγές μένουν στο βιβλίο σου."
          }
        },
        "es" : {
          "stringUnit" : {
