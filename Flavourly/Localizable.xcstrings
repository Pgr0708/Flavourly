    "Your allergies, diet and dislikes rule out everything in this category." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساسياتك ونظامك الغذائي وما لا تحبه تستبعد كل شيء في هذه الفئة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Allergien, Ernährung und Abneigungen schließen alles in dieser Kategorie aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλεργίες, η διατροφή και όσα δεν σου αρέσουν αποκλείουν τα πάντα σε αυτή την κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus alergias, dieta y lo que no te gusta descartan todo en esta categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos allergies, régime et aversions excluent tout dans cette catégorie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी एलर्जी, आहार और नापसंद इस श्रेणी की हर चीज़ को बाहर कर देते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allergie, dieta e preferenze escludono tutto in questa categoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アレルギー、食事スタイル、苦手なものにより、このカテゴリはすべて除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알레르기, 식단, 싫어하는 음식 때문에 이 범주는 모두 제외돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas alergias, dieta e restrições excluem tudo nesta categoria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши аллергии, диета и нелюбимые продукты исключают всё в этой категории."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerjilerin, beslenmen ve sevmediklerin bu kategorideki her şeyi dışarıda bırakıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dị ứng, chế độ ăn và món không thích của bạn loại bỏ mọi thứ trong mục này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的过敏原、饮食和忌口排除了此类别的所有内容。"
          }
        }
      }
    },
    "Your answers are kept as a starting point. Recipes and plans are not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ إجاباتك كنقطة بداية. لا تتأثر الوصفات والخطط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Antworten bleiben als Ausgangspunkt erhalten. Rezepte und Pläne ändern sich nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι απαντήσεις σου κρατιούνται ως αφετηρία. Οι συνταγές και τα προγράμματα δεν επηρεάζονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas se guardan como punto de partida. Las recetas y los planes no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réponses sont gardées comme point de départ. Les recettes et plannings ne changent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जवाब शुरुआती बिंदु के रूप में रखे गए हैं। रेसिपी और योजनाएँ प्रभावित नहीं होतीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue risposte restano come punto di partenza. Ricette e piani non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は出発点として残ります。レシピと献立は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변은 시작점으로 유지돼요. 레시피와 계획은 바뀌지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas respostas ficam como ponto de partida. Receitas e planos não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши ответы сохраняются как отправная точка. Рецепты и планы не меняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cevapların başlangıç noktası olarak saklanır. Tarifler ve planlar etkilenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời được giữ làm điểm xuất phát. Công thức và kế hoạch không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的答案会作为起点保留。食谱和计划不受影响。"
          }
        }
      }
    },
