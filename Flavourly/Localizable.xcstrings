    "Write one per line, like “200 g spaghetti” or “2 cloves garlic, crushed”. Hold and drag to reorder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب عنصرًا في كل سطر، مثل «200 غ سباغيتي» أو «2 فص ثوم، مهروس». اضغط مطولًا واسحب لإعادة الترتيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib eins pro Zeile, z. B. „200 g Spaghetti“ oder „2 Knoblauchzehen, zerdrückt“. Halten und ziehen zum Umsortieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε ένα ανά γραμμή, όπως «200 γρ. σπαγγέτι» ή «2 σκελίδες σκόρδο, λιωμένες». Κράτα πατημένο και σύρε για αλλαγή σειράς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe uno por línea, como “200 g de espaguetis” o “2 dientes de ajo, machacados”. Mantén pulsado y arrastra para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez-en un par ligne, comme « 200 g de spaghetti » ou « 2 gousses d’ail, écrasées ». Maintenez et faites glisser pour réordonner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पंक्ति में एक लिखें, जैसे “200 ग्रा. स्पेगेटी” या “2 कली लहसुन, कुचला हुआ”। क्रम बदलने के लिए दबाकर खींचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivine uno per riga, come “200 g di spaghetti” o “2 spicchi d’aglio, schiacciati”. Tieni premuto e trascina per riordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1行に1つ書いてください（例：「スパゲッティ 200 g」「にんにく 2かけ、つぶす」）。長押ししてドラッグすると並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 줄에 하나씩 쓰세요. 예: “스파게티 200 g”, “마늘 2쪽, 으깬 것”. 길게 눌러 끌면 순서를 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva um por linha, como “200 g de espaguete” ou “2 dentes de alho, amassados”. Segure e arraste para reordenar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите по одному на строку, например «200 г спагетти» или «2 зубчика чеснока, раздавить». Удерживайте и перетаскивайте, чтобы изменить порядок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satıra bir tane yaz, örneğin “200 g spagetti” veya “2 diş sarımsak, ezilmiş”. Sırayı değiştirmek için basılı tutup sürükle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi dòng một món, ví dụ “200 g mì Ý” hoặc “2 tép tỏi, đập dập”. Nhấn giữ và kéo để sắp xếp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行写一个，例如“意大利面 200克”或“大蒜 2瓣，拍碎”。按住拖动可调整顺序。"
          }
        }
      }
    },
