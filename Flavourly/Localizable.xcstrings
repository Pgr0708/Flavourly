    "Plan a few meals and their ingredients appear here, merged and sorted by aisle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطّط بضع وجبات وستظهر مكوناتها هنا مدمجة ومرتبة حسب القسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane ein paar Mahlzeiten und ihre Zutaten erscheinen hier, zusammengefasst und nach Gang sortiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προγραμμάτισε μερικά γεύματα και τα υλικά τους θα εμφανιστούν εδώ, συγχωνευμένα και ταξινομημένα ανά διάδρομο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica algunas comidas y sus ingredientes aparecerán aquí, combinados y ordenados por pasillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez quelques repas et leurs ingrédients apparaîtront ici, regroupés et triés par rayon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भोजन प्लान करें और उनकी सामग्री यहाँ दिखेगी, जोड़ी हुई और सेक्शन के अनुसार।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica qualche pasto e i suoi ingredienti appariranno qui, uniti e ordinati per reparto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事をいくつか計画すると、その材料がまとめて売り場ごとに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식사를 몇 개 계획하면 재료가 합쳐져 코너별로 여기에 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeje algumas refeições e os ingredientes aparecem aqui, somados e organizados por corredor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запланируйте несколько блюд — их ингредиенты появятся здесь, объединённые и разложенные по отделам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç öğün planla; malzemeleri burada birleştirilmiş ve reyona göre sıralanmış olarak görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lên kế hoạch vài bữa, nguyên liệu sẽ hiện ở đây, đã gộp và sắp xếp theo quầy."
          }
        },
        "zh-Hans" : {
