    "New recipes built around what you have. Every idea is re-checked against everyone's allergies before you see it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصفات جديدة مبنية على ما لديك. تُفحص كل فكرة من جديد حسب حساسيات الجميع قبل أن تراها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Rezepte rund um das, was du hast. Jede Idee wird noch einmal mit allen Allergien geprüft, bevor du sie siehst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νέες συνταγές με ό,τι έχεις. Κάθε ιδέα ελέγχεται ξανά για τις αλλεργίες όλων πριν τη δεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recetas nuevas creadas con lo que tienes. Cada idea se vuelve a comprobar con las alergias de todos antes de que la veas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nouvelles recettes autour de ce que vous avez. Chaque idée est revérifiée selon les allergies de tous avant de vous être montrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास की चीज़ों से बनी नई रेसिपी। हर आइडिया आपको दिखाने से पहले सबकी एलर्जी से दोबारा जाँचा जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuove ricette pensate su ciò che hai. Ogni idea viene ricontrollata con le allergie di tutti prima che tu la veda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手元の材料で作る新しいレシピ。表示する前に、全員のアレルギーと再確認しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가진 재료로 만든 새 레시피예요. 모든 아이디어는 보여 드리기 전에 모두의 알레르기로 다시 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receitas novas feitas com o que você tem. Cada ideia é conferida de novo com as alergias de todos antes de você ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые рецепты из того, что у вас есть. Перед показом каждая идея заново проверяется по аллергиям всех."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elindekilerle hazırlanmış yeni tarifler. Her fikir sana gösterilmeden önce herkesin alerjilerine göre yeniden kontrol edilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công thức mới dựa trên những gì bạn có. Mỗi gợi ý đều được kiểm tra lại theo dị ứng của mọi người trước khi bạn xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "围绕你已有的东西生成的新食谱。每个灵感在你看到之前都会再次按所有人的过敏原检查。"
          }
        }
      }
    },
