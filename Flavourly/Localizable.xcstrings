        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте свои видео или те, что вы сохранили сами. Для Instagram или TikTok поделитесь ссылкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
