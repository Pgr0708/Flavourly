        }
      }
    },
    "Deletes every recipe, plan, list, pantry item, person and log on this iPhone and in iCloud. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل الوصفات والخطط والقوائم وعناصر المخزن والأشخاص والسجلات على هذا الـ iPhone وفي iCloud. لا يمكن التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Rezepte, Pläne, Listen, Vorratsartikel, Personen und Einträge auf diesem iPhone und in iCloud. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει κάθε συνταγή, πρόγραμμα, λίστα, είδος ντουλαπιού, άτομο και καταγραφή σε αυτό το iPhone και στο iCloud. Δεν αναιρείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas las recetas, planes, listas, artículos de la despensa, personas y registros de este iPhone y de iCloud. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les recettes, plannings, listes, articles du garde-manger, personnes et journaux sur cet iPhone et dans iCloud. C’est définitif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone और iCloud से हर रेसिपी, योजना, सूची, पैंट्री आइटम, व्यक्ति और लॉग मिटा देता है। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ogni ricetta, piano, lista, articolo della dispensa, persona e registro su questo iPhone e in iCloud. L’azione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneとiCloudにあるレシピ、献立、リスト、パントリー、メンバー、記録をすべて削除します。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone과 iCloud에 있는 모든 레시피, 계획, 목록, 보관함 항목, 사람, 기록을 삭제해요. 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as receitas, planos, listas, itens da despensa, pessoas e registros deste iPhone e do iCloud. Não dá para desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все рецепты, планы, списки, запасы, людей и записи на этом iPhone и в iCloud. Это нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’daki ve iCloud’daki tüm tarifleri, planları, listeleri, kiler ürünlerini, kişileri ve kayıtları siler. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi công thức, kế hoạch, danh sách, món trong tủ đồ, người và nhật ký trên iPhone này và trong iCloud. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此iPhone和iCloud上的所有食谱、计划、清单、储藏物品、成员和记录。此操作无法撤销。"
          }
        }
      }
    },
