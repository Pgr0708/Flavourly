    "Imports estimate it automatically. You can still cook and plan this recipe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدّرها عمليات الاستيراد تلقائيًا. ما زال بإمكانك طبخ هذه الوصفة وتخطيطها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe schätzen das automatisch. Du kannst das Rezept trotzdem kochen und planen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εισαγωγές το υπολογίζουν αυτόματα. Μπορείς και πάλι να μαγειρέψεις και να προγραμματίσεις αυτή τη συνταγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las importaciones lo calculan automáticamente. Aun así puedes cocinar y planificar esta receta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les importations l’estiment automatiquement. Vous pouvez quand même cuisiner et planifier cette recette."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इम्पोर्ट इसका अनुमान अपने-आप लगाते हैं। आप फिर भी यह रेसिपी बना और योजना में रख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le importazioni la stimano in automatico. Puoi comunque cucinare e pianificare questa ricetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込み時に自動で推定されます。このレシピは作ることも献立に入れることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기 시 자동으로 추정돼요. 이 레시피는 그대로 요리하고 계획할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As importações estimam isso automaticamente. Você ainda pode cozinhar e planejar esta receita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При импорте это рассчитывается автоматически. Рецепт всё равно можно готовить и планировать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarımlar bunu otomatik tahmin eder. Bu tarifi yine de pişirip planlayabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nhập sẽ tự động ước tính. Bạn vẫn có thể nấu và lên kế hoạch cho công thức này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入时会自动估算。你仍然可以做这道菜并加入计划。"
          }
        }
      }
    },
