    "Mild keeps chilli-heavy dishes out of suggestions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«خفيف» يستبعد الأطباق كثيرة الفلفل الحار من الاقتراحات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mild“ hält sehr scharfe Gerichte aus den Vorschlägen heraus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Ήπιο» κρατά τα πολύ καυτερά πιάτα εκτός προτάσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suave deja fuera de las sugerencias los platos con mucho chile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Doux » écarte des suggestions les plats très pimentés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘हल्का’ ज़्यादा मिर्च वाले व्यंजनों को सुझावों से बाहर रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Delicato” esclude dai suggerimenti i piatti molto piccanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイルドを選ぶと、辛い料理は提案から外れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순한 맛을 고르면 매운 요리는 추천에서 빠져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suave deixa pratos muito apimentados fora das sugestões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Мягкое» убирает из предложений очень острые блюда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafif, çok acılı yemekleri önerilerin dışında tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cay sẽ loại món nhiều ớt khỏi gợi ý."
          }
        },
        "zh-Hans" : {
