    "Product data from Open Food Facts (openfoodfacts.org), shared under the Open Database License. Always check the pack for allergens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات المنتجات من Open Food Facts (openfoodfacts.org)، مشاركة بموجب Open Database License. تحقّق دائمًا من مسبّبات الحساسية على العبوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produktdaten von Open Food Facts (openfoodfacts.org), geteilt unter der Open Database License. Prüfe Allergene immer auf der Verpackung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεδομένα προϊόντων από το Open Food Facts (openfoodfacts.org), με άδεια Open Database License. Έλεγχε πάντα τα αλλεργιογόνα στη συσκευασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos del producto de Open Food Facts (openfoodfacts.org), compartidos bajo la Open Database License. Revisa siempre el envase por los alérgenos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données produit d’Open Food Facts (openfoodfacts.org), partagées sous Open Database License. Vérifiez toujours l’emballage pour les allergènes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्पाद डेटा Open Food Facts (openfoodfacts.org) से, Open Database License के तहत साझा। एलर्जन के लिए हमेशा पैक जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati prodotto da Open Food Facts (openfoodfacts.org), condivisi con Open Database License. Controlla sempre gli allergeni sulla confezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品データはOpen Food Facts（openfoodfacts.org）からOpen Database Licenseで提供されています。アレルゲンは必ずパッケージで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제품 데이터는 Open Food Facts(openfoodfacts.org)에서 Open Database License로 제공돼요. 알레르기 유발 성분은 항상 포장에서 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados do produto do Open Food Facts (openfoodfacts.org), compartilhados sob a Open Database License. Sempre confira os alérgenos na embalagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные о товарах — Open Food Facts (openfoodfacts.org), по лицензии Open Database License. Всегда проверяйте аллергены на упаковке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ürün verileri Open Food Facts’ten (openfoodfacts.org), Open Database License kapsamında paylaşılmıştır. Alerjenleri her zaman paketten kontrol et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu sản phẩm từ Open Food Facts (openfoodfacts.org), chia sẻ theo Open Database License. Luôn kiểm tra chất gây dị ứng trên bao bì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品数据来自Open Food Facts（openfoodfacts.org），依据Open Database License共享。请务必查看包装上的过敏原信息。"
          }
        }
      }
    },
