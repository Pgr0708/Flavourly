    "Cook smarter, plan better, and save more\ntime every week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطبخ بذكاء، خطّط أفضل، ووفّر مزيدًا من\nالوقت كل أسبوع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klüger kochen, besser planen und jede Woche\nmehr Zeit sparen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μαγείρεψε έξυπνα, προγραμμάτισε καλύτερα και κέρδισε\nπερισσότερο χρόνο κάθε εβδομάδα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocina con más cabeza, planifica mejor y ahorra más\ntiempo cada semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisinez malin, planifiez mieux et gagnez du\ntemps chaque semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समझदारी से बनाएँ, बेहतर योजना बनाएँ और हर हफ़्ते\nज़्यादा समय बचाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cucina in modo più furbo, pianifica meglio e risparmia più\ntempo ogni settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賢く作って、上手に計画して、毎週もっと\n時間を節約。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 똑똑하게 요리하고, 더 잘 계획하고, 매주 더 많은\n시간을 아끼세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cozinhe com mais inteligência, planeje melhor e economize mais\ntempo toda semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовьте с умом, планируйте лучше и экономьте больше\nвремени каждую неделю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha akıllı pişir, daha iyi planla ve her hafta daha fazla\nzaman kazan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nấu thông minh, lên kế hoạch tốt hơn và tiết kiệm thêm\nthời gian mỗi tuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做饭更聪明，计划更周全，每周节省更多\n时间。"
          }
        }
      }
    },
