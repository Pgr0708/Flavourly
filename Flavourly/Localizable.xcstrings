    "Speech recognition is off for Flavourly. Turn it on in Settings › Privacy › Speech Recognition." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعرّف على الكلام متوقف لـ Flavourly. فعّله من الإعدادات › الخصوصية › التعرّف على الكلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung ist für Flavourly ausgeschaltet. Schalte sie unter Einstellungen › Datenschutz › Spracherkennung ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναγνώριση ομιλίας είναι απενεργοποιημένη για το Flavourly. Ενεργοποίησέ τη στις Ρυθμίσεις › Απόρρητο › Αναγνώριση ομιλίας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz está desactivado para Flavourly. Actívalo en Ajustes › Privacidad › Reconocimiento de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale est désactivée pour Flavourly. Activez-la dans Réglages › Confidentialité › Reconnaissance vocale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flavourly के लिए स्पीच रिकग्निशन बंद है। इसे सेटिंग्स › गोपनीयता › स्पीच रिकग्निशन में चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale è disattivato per Flavourly. Attivalo in Impostazioni › Privacy › Riconoscimento vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flavourlyの音声認識がオフです。設定 › プライバシー › 音声認識でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flavourly의 음성 인식이 꺼져 있어요. 설정 › 개인정보 보호 › 음성 인식에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de fala está desativado para o Flavourly. Ative em Ajustes › Privacidade › Reconhecimento de Fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи для Flavourly выключено. Включите его в Настройки › Конфиденциальность › Распознавание речи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flavourly için konuşma tanıma kapalı. Ayarlar › Gizlilik › Konuşma Tanıma’dan aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dạng giọng nói đang tắt với Flavourly. Bật trong Cài đặt › Quyền riêng tư › Nhận dạng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flavourly的语音识别已关闭。请在 设置 › 隐私 › 语音识别 中开启。"
          }
        }
      }
    },
    "Speech recognition isn't available for your language on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
