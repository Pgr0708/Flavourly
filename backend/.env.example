# Flavourly API — copy to `.env` (cp .env.example .env) and fill in. Never commit .env.

NODE_ENV=production
# Listen on localhost only; Nginx is the public entry point. Pick a port nothing else uses
# (check with: sudo ss -ltnp | grep ':4815 ').
HOST=127.0.0.1
PORT=4815
PUBLIC_URL=https://flavourly.dakshyaminfotech.store
TRUST_PROXY=loopback

# MySQL — a dedicated database and user (see deploy/setup-mysql.sql). Not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_USER=flavourly_app
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=flavourly
# Connections per process. Total = DB_POOL_SIZE × PM2 instances; keep it well below MySQL's
# max_connections because other sites on this server share the same MySQL.
DB_POOL_SIZE=5

# Redis — shared cache, rate limits and sessions across PM2 workers / servers.
# Leave empty to use in-process memory (fine for a single instance). Database 0 is fine:
# every key starts with REDIS_PREFIX, so other apps' keys are never read or touched.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=flavourly:

# OpenAI — the key lives ONLY here, never in the iOS app.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=45000

# Optional: lets YouTube imports read full video descriptions (YouTube Data API v3 key).
YOUTUBE_API_KEY=

# Verified nutrition. Free key (instant, by email): https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for testing but allows only ~30 requests an hour.
USDA_API_KEY=DEMO_KEY
# Optional: fills in ingredients USDA can't match (e.g. paneer). https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=

# Optional: verifies Premium with RevenueCat (secret API key, starts with sk_). Empty = everyone is on the free plan limits.
REVENUECAT_SECRET_KEY=
# Entitlement ids from your RevenueCat dashboard, comma-separated (the app checks pro and lifetime).
REVENUECAT_ENTITLEMENT=pro,lifetime

# Recipe photos: free sources first (each photo must show the dish; credits are kept), GPT only when none match.
# Spoonacular photos get their own daily budget so nutrition keeps most of the 150 points.
SPOONACULAR_PHOTOS_PER_DAY=40
# Optional free stock photos: https://www.pexels.com/api/ (200/hour) and https://unsplash.com/developers (50/hour).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# https://pixabay.com/api/docs/ (free). Pixabay photos are downloaded and served from IMAGE_DIR (no hotlinking).
PIXABAY_API_KEY=
# TheMealDB: "1" is the free development key. For the App Store release use your supporter key (themealdb.com/api.php).
THEMEALDB_API_KEY=1
# Openverse needs no key.
# Last resort when no free photo matches: GPT image-1, made once per dish and shared by everyone.
IMAGE_GENERATION=0
IMAGE_MODEL=gpt-image-1
# low ≈ $0.01, medium ≈ $0.04, high ≈ $0.17 per photo. Low looks fine on phone cards.
IMAGE_QUALITY=low
# IMAGE_DIR=/var/www/flavourly-api/public/images

# Free plan (per device). Premium is unlimited.
FREE_IMPORTS_PER_WEEK=5
FREE_AI_PLANS_PER_WEEK=1
FREE_AI_IDEAS_PER_WEEK=5
FREE_AI_SWAPS_PER_WEEK=10
FREE_IMAGES_PER_WEEK=3
FREE_EXTRACTS_PER_DAY=20

# Abuse protection.
RATE_LIMIT_PER_MINUTE=60
REGISTRATIONS_PER_HOUR=20
