{
  "name": "flavourly-api",
  "version": "1.0.0",
  "private": true,
  "description": "Flavourly API: recipe import, AI swaps, Cook Now ideas and meal planning for the Flavourly iOS app.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "fake-openai": "node test/fake-openai.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check:live": "node scripts/live-check.js",
    "check:nutrition": "node scripts/nutrition-bench.js",
    "check:photos": "node scripts/photo-check.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "mysql2": "^3.24.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "redis-memory-server": "^0.17.1"
  },
  "redisMemoryServer": {
    "version": "7.2.7"
  }
}
